# Python
__pycache__/
*.pyc
.venv/

# Secrets — never commit real API keys or credentials
.env

# Local data — the SQLite database and Chroma vector store live here.
# These are generated by running the app, not source code, so they
# don't belong in version control (and papers you upload may not be
# yours to redistribute via a public repo).
data/*
!data/.gitkeep

